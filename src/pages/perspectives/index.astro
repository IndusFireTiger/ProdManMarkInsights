---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SKILLS, SERIES } from '../../content.config';

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });

// Short chip labels for each skill highlight (filter bar + per-post tag).
const SKILL_LABEL: Record<string, string> = {
  'Product Strategy & Vision': 'Strategy',
  'Go-to-Market & Product Marketing': 'Marketing',
  'Applied AI in Product': 'Applied AI',
  'Agile Leadership & Change': 'Leadership',
  'EdTech & Education': 'EdTech',
};

const posts = (await getCollection('perspectives'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Only surface filter chips for skills that have at least one published post,
// kept in the canonical SKILLS order.
const skillsInUse = SKILLS.filter((s) => posts.some((p) => p.data.skill === s));

// Series members collapse into one grouped row, placed where the most recent
// part falls in the chronological list. Everything else renders as before.
type Post = CollectionEntry<'perspectives'>;
type Row =
  | { kind: 'post'; post: Post }
  | { kind: 'series'; id: keyof typeof SERIES; parts: Post[] };

const rows: Row[] = [];
const placed = new Set<string>();
for (const post of posts) {
  const id = post.data.series;
  if (!id) {
    rows.push({ kind: 'post', post });
    continue;
  }
  if (placed.has(id)) continue;
  placed.add(id);
  rows.push({
    kind: 'series',
    id: id as keyof typeof SERIES,
    parts: posts
      .filter((p) => p.data.series === id)
      .sort((a, b) => (a.data.part ?? Infinity) - (b.data.part ?? Infinity)),
  });
}
---
<BaseLayout
  title="Perspectives — ProdMan·Insights"
  description="Essays and frameworks on product strategy, product marketing and applied AI, filed by skill."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h1 style="max-width:18ch;">Perspectives</h1>
      <p class="lede muted" style="max-width:54ch;">
        Frameworks, essays and field notes on how products are imagined,
        validated, marketed — and where applied AI changes the craft. Filter
        by the skill each piece speaks to.
      </p>

      <div class="filter-bar" data-filter-bar aria-label="Filter perspectives by skill">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">
          All<span class="chip__count">{posts.length}</span>
        </button>
        {skillsInUse.map((s) => (
          <button class="chip" type="button" data-filter={s} aria-pressed="false">
            {SKILL_LABEL[s] ?? s}
            <span class="chip__count">{posts.filter((p) => p.data.skill === s).length}</span>
          </button>
        ))}
      </div>

      <ul class="post-list" style="margin-top:2rem;" data-post-list>
        {rows.map((row) => row.kind === 'post' ? (
          <li data-skill={row.post.data.skill}>
            <a href={`/perspectives/${row.post.id}`}>
              <span class="post-skill">{SKILL_LABEL[row.post.data.skill] ?? row.post.data.skill}</span>
              <span class="post-title">{row.post.data.title}</span>
              <span class="post-meta">{dateFmt(row.post.data.date)}{row.post.data.readingTime ? ` · ${row.post.data.readingTime}` : ''}</span>
              <p class="post-summary">{row.post.data.summary}</p>
            </a>
          </li>
        ) : (
          <li class="series" id={`series-${row.id}`} data-series>
            <p class="post-skill">Series · {row.parts.length} parts</p>
            <h2 class="series__title">{SERIES[row.id].title}</h2>
            <p class="series__blurb muted">{SERIES[row.id].blurb}</p>
            <ol class="series__parts">
              {row.parts.map((p) => (
                <li data-skill={p.data.skill} data-part>
                  <a href={`/perspectives/${p.id}`}>
                    <span class="series__num" aria-hidden="true">{String(p.data.part ?? '·').padStart(2, '0')}</span>
                    <span class="series__part-title">{p.data.title}</span>
                    <span class="series__part-meta">
                      {SKILL_LABEL[p.data.skill] ?? p.data.skill}{p.data.readingTime ? ` · ${p.data.readingTime}` : ''}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ul>

      <p class="muted filter-empty" data-filter-empty hidden style="margin-top:2rem;">
        No perspectives under this skill yet.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const bar = document.querySelector('[data-filter-bar]');
  // Top-level rows: either a single post, or a series block holding parts.
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>('[data-post-list] > li')
  );
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const filter = btn.dataset.filter ?? 'all';

    bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((c) =>
      c.setAttribute('aria-pressed', String(c === btn))
    );

    let visible = 0;
    for (const row of rows) {
      if (row.hasAttribute('data-series')) {
        // A series survives the filter if any of its parts does; the parts that
        // don't match are hidden inside it.
        let shown = 0;
        row.querySelectorAll<HTMLElement>('[data-part]').forEach((part) => {
          const show = filter === 'all' || part.dataset.skill === filter;
          part.hidden = !show;
          if (show) shown++;
        });
        row.hidden = shown === 0;
        visible += shown;
      } else {
        const show = filter === 'all' || row.dataset.skill === filter;
        row.hidden = !show;
        if (show) visible++;
      }
    }
    if (empty) empty.hidden = visible !== 0;
  });
</script>
