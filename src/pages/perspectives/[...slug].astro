---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import TermsInThisPiece from '../../components/TermsInThisPiece.astro';
import { articleSchema } from '../../lib/schema';
import { SERIES } from '../../content.config';

export async function getStaticPaths() {
  const entries = await getCollection('perspectives');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateFmt = entry.data.date.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const meta = [dateFmt, entry.data.readingTime, ...entry.data.topics].filter(
  Boolean
) as string[];

// Series membership, if any — rendered as a short note above the essay.
const seriesId = entry.data.series as keyof typeof SERIES | undefined;
const series = seriesId
  ? {
      ...SERIES[seriesId],
      anchor: `/perspectives#series-${seriesId}`,
      part: entry.data.part,
      total: (await getCollection('perspectives')).filter(
        (p) => !p.data.draft && p.data.series === seriesId
      ).length,
    }
  : null;

const jsonLd = articleSchema({
  site: Astro.site,
  path: `/perspectives/${entry.id}`,
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date,
  keywords: [entry.data.skill, ...entry.data.topics],
});
---
<ProseLayout
  title={entry.data.title}
  description={entry.data.summary}
  eyebrow="Perspective"
  meta={meta}
  backHref="/perspectives"
  backLabel="All perspectives"
  jsonLd={jsonLd}
  noindex={entry.data.draft}
>
  {series && (
    <p class="series-note">
      {series.part ? `Part ${series.part} of ${series.total} in ` : 'Part of '}
      <a href={series.anchor}>{series.title}</a>
    </p>
  )}
  <Content />
  <TermsInThisPiece />
</ProseLayout>
