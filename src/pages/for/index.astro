---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LENSES } from '../../lib/lenses';
---
<BaseLayout
  title="Reading paths by role — ProdMan·Insights"
  description="The same work, read through the lens of the role you are hiring for: AI product, product leadership, product marketing, regulated domains or EdTech."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Start here</p>
      <h1 style="max-width:18ch;">Reading paths by role</h1>
      <p class="lede muted" style="max-width:56ch;">
        Hiring for a particular kind of role? Pick the closest one for a short
        pitch and the case studies and essays most relevant to it.
      </p>
      <div class="card-grid" style="margin-top:3rem;">
        {LENSES.map((l) => (
          <a class="card" href={`/for/${l.id}`}>
            <span class="tag">Reading path</span>
            <h3>{l.label}</h3>
            <p>{l.pitch.split('. ')[0]}.</p>
            <span class="more">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
